# Saltos de línea normalizados (evita diffs enteros entre Windows y macOS/Linux)
* text=auto eol=lf

# Diffs de LaTeX con el nombre de la sección en la cabecera de cada cambio
*.tex text diff=tex
*.bib text diff=bibtex

# Binarios
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.docx binary
*.xlsx binary
*.pptx binary
*.zip  binary

# Si vas a versionar ficheros grandes (datasets, modelos) usa Git LFS, p. ej.:
# *.h5 filter=lfs diff=lfs merge=lfs -text
